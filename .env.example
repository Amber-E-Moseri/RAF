# Frontend API base URL.
# For local dev this is usually http://localhost:3000/api/v1
# Leaving this empty defaults to /api/v1.
VITE_API_BASE_URL=

# Backend API port.
PORT=3000

# Persistence driver: 'sqlite' (default, local dev) or 'postgres' (shared/production).
PERSISTENCE_DRIVER=sqlite

# SQLite database path. Required when PERSISTENCE_DRIVER=sqlite.
# Relative paths are resolved from the app root.
RAF_DB_PATH=./db/raf.sqlite

# ── Postgres configuration (required when PERSISTENCE_DRIVER=postgres) ──────

# Privileged connection string — used by scripts/migrate.js and by the server
# as a fallback when POSTGRES_CONNECTION_STRING_APP is not set.
# This role should be neondb_owner or equivalent (has CREATE TABLE, BYPASSRLS).
# Never expose this to end users or the runtime application server.
# Example: postgresql://neondb_owner:<password>@<host>/neondb?sslmode=require
POSTGRES_CONNECTION_STRING=

# Runtime application connection string — used by the API server.
# Must connect as raf_app (NOBYPASSRLS NOSUPERUSER) so PostgreSQL RLS is active.
# See db/migrations/20260909000000_create_raf_app_role.sql for role setup.
# If not set, the server falls back to POSTGRES_CONNECTION_STRING and logs a
# startup warning when RAF_AUTH_REQUIRED=true.
# Example: postgresql://raf_app:<password>@<host>/neondb?sslmode=require
POSTGRES_CONNECTION_STRING_APP=

# ── Auth configuration ───────────────────────────────────────────────────────

# Set to 'true' for any shared or production deployment.
# Without this, the workspace header is accepted without membership verification.
# Required when PERSISTENCE_DRIVER=postgres; warning is logged if absent.
RAF_AUTH_REQUIRED=false

# Secret used to sign and verify JWTs. Must be set when RAF_AUTH_REQUIRED=true.
# Minimum 32 characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── Error monitoring ─────────────────────────────────────────────────────────

# Sentry DSN for error monitoring. When absent the server runs with no Sentry
# integration — safe and correct for local development.
# Obtain from: Sentry project → Settings → Client Keys (DSN).
# Request bodies and Authorization headers are stripped before sending.
SENTRY_DSN=

# Comma-separated list of additional CORS-allowed origins beyond localhost.
# Set this on the backend host to allow your deployed frontend(s).
# Example: ALLOWED_ORIGINS=https://normisraf.netlify.app,https://raf.yourdomain.com
ALLOWED_ORIGINS=

# ── Observability ────────────────────────────────────────────────────────────

# Anthropic API key — required for AI-assisted PDF bank-statement import.
# Obtain from: https://console.anthropic.com/settings/api-keys
ANTHROPIC_API_KEY=

# Git SHA of the deployed commit, exposed on GET /health as `sha`.
# Set by the deploy pipeline (e.g. RENDER_GIT_COMMIT on Render).
# Omit for local development — the field is absent when unset.
RAF_BUILD_SHA=
